# Built site (make docs-build). The leading slash matters: tools/site/ is source.
/site/

# Zensical build cache
/.cache/

# Local virtual environment (python3 -m venv .venv)
/.venv/

# Python bytecode
__pycache__/

# Generated by tools/site/prebuild.py
/docs/assets/data/updates.json

# Downloaded by tools/site/fetch_vendor.py (make docs-deps)
/docs/assets/vendor/mermaid/mermaid.min.js
