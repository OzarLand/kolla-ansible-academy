% e6 lab addition: RabbitMQ 3.6.10 translation of rabbitmq.conf + advanced.config
[
 {rabbit, [{tcp_listeners, [{"127.0.0.1", 18643}]},
           {cluster_partition_handling, pause_minority},
           {cluster_nodes, {['rabbit@vm'], disc}}]},
 {rabbitmq_management, [{listener, [{ip, "127.0.0.1"}, {port, 18644}]},
                        {load_definitions, "/etc/rabbitmq/definitions.json"}]},
 {kernel, [{inet_dist_use_interface, {127,0,0,1}},
           {inet_dist_listen_min, 18642},
           {inet_dist_listen_max, 18642}]}
].
