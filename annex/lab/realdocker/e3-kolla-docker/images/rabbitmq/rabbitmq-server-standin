#!/usr/bin/python3
# e3 STAND-IN for /usr/sbin/rabbitmq-server. NOT RabbitMQ.
# Logs its start (config marker, env cookie, cookie file) and every catchable signal it receives; ignores SIGTERM,
# like a service that is still busy when docker stop sends SIGTERM.
import os, signal, sys, time

logdir = os.environ.get('RABBITMQ_LOG_DIR', '/var/log/kolla/rabbitmq')
logfile = os.path.join(logdir, 'standin.log')


def w(msg):
    line = '%.3f pid=%d %s\n' % (time.time(), os.getpid(), msg)
    with open(logfile, 'a') as f:
        f.write(line)
    sys.stdout.write(line)
    sys.stdout.flush()


def handler(sig, frame):
    w('got %s -> ignored, still running' % signal.Signals(sig).name)


for s in signal.Signals:
    if s in (signal.SIGKILL, signal.SIGSTOP, signal.SIGCHLD):
        continue
    try:
        signal.signal(s, handler)
    except (OSError, ValueError, RuntimeError):
        pass


def first_line(path):
    try:
        with open(path) as f:
            return f.readline().strip()
    except OSError as e:
        return 'unreadable(%s)' % e.strerror


w('start ppid=%d rabbitmq.conf=%r env_cookie=%r file_cookie=%r' % (
    os.getppid(), first_line('/etc/rabbitmq/rabbitmq.conf'),
    os.environ.get('RABBITMQ_CLUSTER_COOKIE'), first_line('/var/lib/rabbitmq/.erlang.cookie')))
while True:
    signal.pause()
