#!/bin/bash
# Stand-in for nova-compute (experiment e2). It logs its user, argv and every signal it receives to stdout and to
# /var/log/kolla/nova/nova-compute.log, and otherwise idles. It reads no configuration.
log=/var/log/kolla/nova/nova-compute.log
say() { echo "$(date -u +%FT%T.%N) nova-compute-standin[$$] $*" | tee -a "$log"; }
trap 'say got SIGTERM; exit 0' TERM
trap 'say got SIGINT; exit 0' INT
trap 'say got SIGHUP' HUP
say "start user=$(id -un) groups=$(id -Gn | tr ' ' ',') argv=[$*]"
while true; do sleep 1 & wait $!; done
